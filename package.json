{
  "name": "jiandu-reader",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "npm run test:js && npm run test:rust",
    "test:js": "node --test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "scan": "cargo run --manifest-path src-tauri/Cargo.toml --bin scan --",
    "build:vendor": "node scripts/build-vendor.mjs"
  },
  "dependencies": {
    "chmlib-ts": "^0.3.0",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
