{
  "productName": "简读",
  "version": "0.2.0",
  "identifier": "com.jiandu.reader",
  "mainBinaryName": "jiandu",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build:desktop",
    "features": ["custom-protocol"]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "简读 · 本地书库",
        "width": 1180,
        "height": 800,
        "minWidth": 860,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/icon.ico"],
    "publisher": "fanyb",
    "shortDescription": "简读 · 本地书库阅读器",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
